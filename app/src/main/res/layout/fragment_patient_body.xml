<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/interactive_body_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/iv_body_doctor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/body_silhouette" />

            <!-- Ancoră invizibilă pentru centrare -->
            <View
                android:id="@+id/center_anchor_doctor"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_centerHorizontal="true" />

            <ImageButton
                android:id="@+id/view_heart_doctor"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="85dp"
                android:src="@drawable/ic_heart"
                android:background="@drawable/bg_icon_circle"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_heart" />

            <ImageButton
                android:id="@+id/view_lungs_doctor"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="110dp"
                android:src="@drawable/ic_lungs"
                android:background="@drawable/bg_icon_circle"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_lungs" />

            <ImageButton
                android:id="@+id/view_skin_doctor"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_toEndOf="@id/center_anchor_doctor"
                android:layout_marginStart="70dp"
                android:layout_marginTop="145dp"
                android:src="@drawable/ic_skin"
                android:background="@drawable/bg_icon_circle"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/desc_skin" />

        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/interactive_body_instruction"
            android:textColor="@android:color/darker_gray"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>