<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/cardioFlowText"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:fitsSystemWindows="true">
	
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		android:orientation="horizontal"
		android:background="?attr/colorPrimary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
		>

		<TextView
			android:id="@+id/cardioFlow_text"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:gravity="center_vertical"
			android:text="@string/app_name"
			android:textColor="?attr/colorOnPrimary"
			android:textSize="20sp"
            android:textStyle="bold" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_doctor_about"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:layout_gravity="center"
			style="@style/Widget.MaterialComponents.Button.TextButton"
			android:text="@string/nav_about"
			android:textColor="?attr/colorOnPrimary" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_doctor_settings"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:layout_gravity="center"
			style="@style/Widget.MaterialComponents.Button.TextButton"
			android:text="@string/nav_settings"
			android:textColor="?attr/colorOnPrimary" />
	</LinearLayout>

    <!-- Mesaj de bun venit -->
	<TextView
		android:id="@+id/tv_doctor_welcome"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:padding="8dp"
		android:textColor="?attr/colorOnSurfaceVariant"
		android:textSize="14sp" />

    <!-- Zonă cu listă pacienți și detalii -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/patients_list_title"
            android:textStyle="bold"
            android:padding="8dp"
            android:textColor="?attr/colorOnSurface"
             />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_patients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:id="@+id/details_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" /> <!-- implicit ascuns -->
    </LinearLayout>

</LinearLayout>
